---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Trust from '../components/Trust.astro';
import Savings from '../components/Savings.astro';
import Platform from '../components/Platform.astro';
import Voyage from '../components/Voyage.astro';
import Paths from '../components/Paths.astro';
import Plans from '../components/Plans.astro';
import Partner from '../components/Partner.astro';
import Rewards from '../components/Rewards.astro';
import FreeMembership from '../components/FreeMembership.astro';
import Leadership from '../components/Leadership.astro';
import Stories from '../components/Stories.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main id="main">
    <Hero />
    <Stats />
    <Trust />
    <Savings />
    <Platform />
    <Voyage />
    <Paths />
    <Plans />
    <Partner />
    <Rewards />
    <FreeMembership />
    <Leadership />
    <Stories />
    <Contact />
  </main>
  <Footer />
