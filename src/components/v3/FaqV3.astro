---
/**
 * Ответы основаны только на фактах из презентации и официального сайта inCruises.
 * Условия, которых там нет (возвраты, отмена и т. п.), сюда не добавлены — уточните их у компании.
 */
const faq = [
  {
    q: 'Что такое бонусные баллы (ББ)?',
    a: 'Это внутренняя система клуба: членские взносы превращаются в бонусные баллы, которыми оплачивается часть стоимости круиза. Например, в плане Classic взнос 100 $ даёт 200 ББ. Это не деньги: правила начисления и использования баллов определяет программа inCruises.',
  },
  {
    q: 'Сколько стоит членство?',
    a: 'Планы начинаются от $50 в месяц. В примере из презентации план Classic — регистрация $200 и далее $100 в месяц, план Premium — регистрация $500 и далее $250 в месяц.',
  },
  {
    q: 'Обязательно ли заниматься бизнесом?',
    a: 'Нет. Можно быть просто членом клуба и путешествовать на клубных условиях. Партнёрство — отдельная опция за $95, оплачивается раз в 6 месяцев и открывает возможность получать доход.',
  },
  {
    q: 'Это легально? Насколько это надёжно?',
    a: 'inCruises работает с 2015 года, зарегистрирована в Калифорнии (№ 2146142-50), Флориде (№ ST-42861) и Вашингтоне (№ 604-762-223), является членом CLIA — Международной ассоциации круизных линий. С июля 2016 года забронировано более 800 000 гостей.',
  },
  {
    q: 'Есть ли скрытые платежи на круизе?',
    a: 'По информации inCruises, в цену бронирования через клуб включены все налоги, сборы и чаевые.',
  },
  {
    q: 'Что можно бронировать?',
    a: 'Более 21 000 вариантов круизов, более 300 000 вариантов размещения inStays и более 350 000 туров и экскурсий inTours в 193 странах — через собственную платформу клуба.',
  },
];
---

<section id="faq" class="relative bg-white py-[clamp(64px,9vw,120px)] text-[#071526]">
  <div class="mx-auto max-w-[860px] px-5 sm:px-8">
    <p class="text-center text-sm font-bold tracking-wide text-brand-600" data-reveal>Частые вопросы</p>
    <h2 class="mt-3 text-center text-[clamp(2rem,4.6vw,3.2rem)] leading-[1.05] font-extrabold tracking-[-0.04em] text-balance" data-split>Отвечаем честно</h2>

    <div class="mt-12 space-y-3">
      {
        faq.map((f, i) => (
          <details name="faq" class="faq group rounded-[24px] bg-[#f4f6fa] transition-colors open:bg-white open:shadow-[0_0_0_2px_rgba(247,148,29,0.35)]" open={i === 0} data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-[17px] font-bold [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white text-xl leading-none text-brand transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="px-6 pb-6 text-[15px] leading-relaxed font-medium text-[#071526]/70">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      content-visibility 0.4s allow-discrete;
  }
  .faq[open]::details-content {
    block-size: auto;
  }
  :global(html) {
    interpolate-size: allow-keywords;
  }
</style>
