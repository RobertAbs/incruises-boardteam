---
import { Picture, Image } from 'astro:assets';
import Icon from '../art/Icon.astro';
import { site } from '../../config';
import dinner from '../../assets/stories/ship-dinner.jpg';
import abuDhabi from '../../assets/stories/abu-dhabi.jpg';
import dubai from '../../assets/stories/dubai.jpg';
import airport from '../../assets/stories/airport.jpg';
import sealCa from '../../assets/brand/seal-ca.png';
import sealFl from '../../assets/brand/seal-fl.png';
import sealWa from '../../assets/brand/seal-wa.png';
import clia from '../../assets/brand/logo-clia.png';

const o = site.owner;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photos = [
  { src: dinner, alt: 'Семья за ужином на борту лайнера' },
  { src: abuDhabi, alt: 'Семья в Абу-Даби' },
  { src: dubai, alt: 'Отец с сыновьями в Дубае' },
  { src: airport, alt: 'Семья в аэропорту' },
];
const promises = ['Поможем выбрать план под ваши цели', 'Проведём регистрацию шаг за шагом', 'Подберём и забронируем первый круиз', 'На связи после поездки'];
---

<section id="team" class="relative bg-[#f4f6fa] py-[clamp(64px,9vw,120px)] text-[#071526]">
  <div class="mx-auto grid max-w-[1240px] items-center gap-12 px-5 sm:px-8 lg:grid-cols-2 lg:gap-16">
    <div class="order-2 lg:order-1">
      <p class="text-sm font-bold tracking-wide text-brand-600" data-reveal>{o.name ? 'Ваш консультант' : 'Команда BoardTeam'}</p>
      <h2 class="mt-3 text-[clamp(2rem,4.6vw,3.2rem)] leading-[1.05] font-extrabold tracking-[-0.04em] text-balance" data-split>
        {o.name ? o.name : 'Не просто сайт — живые люди рядом'}
      </h2>
      <p class="mt-5 max-w-[520px] text-[17px] leading-relaxed font-medium text-[#071526]/70" data-reveal>
        {
          o.story ||
            'Мы — команда независимых партнёров inCruises. Сами путешествуем с клубом всей семьёй и помогаем другим начать: от выбора плана до первого круиза.'
        }
      </p>
      <ul class="mt-8 grid gap-2.5 sm:grid-cols-2" data-reveal>
        {
          promises.map((p) => (
            <li class="flex items-start gap-3 rounded-2xl bg-white px-4 py-3.5 text-[15px] font-semibold">
              <span class="mt-0.5 text-brand">
                <Icon name="check" size={18} />
              </span>
              {p}
            </li>
          ))
        }
      </ul>

      <!-- Надёжность в одну строку -->
      <div class="mt-10 flex flex-wrap items-center gap-5 border-t border-[#071526]/10 pt-8" data-reveal>
        <div class="flex -space-x-3">
          {[sealCa, sealFl, sealWa].map((s) => <Image src={s} alt="" class="h-11 w-11 rounded-full ring-4 ring-[#f4f6fa]" width={88} />)}
        </div>
        <p class="max-w-[260px] text-sm font-semibold text-[#071526]/65">Компания зарегистрирована в Калифорнии, Флориде и Вашингтоне</p>
        <Image src={clia} alt="CLIA — Cruise Lines International Association" class="h-9 w-auto opacity-80" width={240} />
      </div>
    </div>

    <div class="order-1 lg:order-2">
      {
        o.name && o.photo ? (
          <img src={`${base}/${o.photo}`} alt={o.name} class="aspect-[4/5] w-full rounded-[32px] object-cover" loading="lazy" />
        ) : (
          <div class="grid grid-cols-2 gap-3">
            {photos.map((p, i) => (
              <div class:list={['overflow-hidden rounded-[24px]', i % 2 === 1 && 'translate-y-8']} data-reveal>
                <Picture src={p.src} alt={p.alt} widths={[300, 560]} sizes="(min-width:1024px) 22vw, 45vw" formats={['avif', 'webp']} class="aspect-[3/4] w-full object-cover" loading="lazy" />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
