---
import Icon from '../art/Icon.astro';
import { savings } from '../../data/content';

const steps = [
  { n: '01', icon: 'card', title: 'Вступаете в клуб', text: 'Выбираете план членства — от $50 в месяц. Регистрация онлайн за несколько минут.' },
  { n: '02', icon: 'coins', title: 'Копите бонусные баллы', text: 'Каждый взнос превращается в баллы. Например, в плане Classic 100 $ дают 200 ББ.' },
  { n: '03', icon: 'ship', title: 'Путешествуете выгоднее', text: 'Баллами оплачиваете до половины круиза. Налоги, сборы и чаевые уже включены.' },
];
---

<section id="how" class="relative bg-white py-[clamp(64px,9vw,120px)] text-[#071526]">
  <div class="mx-auto max-w-[1240px] px-5 sm:px-8">
    <div class="max-w-[640px]">
      <p class="text-sm font-bold tracking-wide text-brand-600" data-reveal>Как это работает</p>
      <h2 class="mt-3 text-[clamp(2rem,4.6vw,3.2rem)] leading-[1.05] font-extrabold tracking-[-0.04em] text-balance" data-split>Три шага до&nbsp;клубного круиза</h2>
    </div>

    <ol class="mt-12 grid gap-4 md:grid-cols-3">
      {
        steps.map((s) => (
          <li class="group relative overflow-hidden rounded-[28px] bg-[#f4f6fa] p-7" data-reveal>
            <span class="absolute top-4 right-6 text-[64px] leading-none font-extrabold tracking-[-0.06em] text-[#071526]/[0.05]">{s.n}</span>
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-white text-brand shadow-sm transition-transform duration-500 group-hover:-rotate-6">
              <Icon name={s.icon} size={26} />
            </span>
            <p class="mt-8 text-xl font-extrabold tracking-tight">{s.title}</p>
            <p class="mt-2 text-[15px] leading-relaxed font-medium text-[#071526]/65">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {
        savings.map((s, i) => (
          <div class:list={['rounded-[28px] p-7', i === 2 ? 'bg-[#071526] text-white' : 'border-2 border-[#071526]/8']} data-reveal>
            <p class:list={['text-sm font-bold', i === 2 ? 'text-white/60' : 'text-[#071526]/55']}>
              {s.word} · {s.caption}
            </p>
            <p class:list={['mt-3 text-[clamp(3rem,6vw,4.4rem)] leading-none font-extrabold tracking-[-0.05em]', i === 2 ? 'text-brand' : '']}>
              <span class="mr-1 text-[0.4em] font-bold tracking-normal opacity-60">до</span>
              {s.from && <span class="text-[0.6em] opacity-50">{s.from}–</span>}
              <span data-count={s.to} data-suffix="%" data-delay={i * 150}>{s.to}%</span>
            </p>
            <p class:list={['mt-4 text-[15px] font-medium', i === 2 ? 'text-white/70' : 'text-[#071526]/65']}>
              {s.title} {s.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
