---
import { getImage } from 'astro:assets';
import Icon from '../art/Icon.astro';
import poster from '../../assets/v3/cruise-poster.jpg';
import { guests } from '../../data/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posterImg = await getImage({ src: poster, width: 1600, format: 'webp', quality: 70 });
const fmt = (n: number) => n.toLocaleString('ru-RU');
---

<section id="top" class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-[#071526] text-white" aria-label="Главный экран">
  <!-- Видео с дрона -->
  <div class="absolute inset-0 -z-10">
    <video
      id="v3-video"
      class="h-full w-full scale-105 object-cover object-[62%_50%]"
      poster={posterImg.src}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      data-src-desktop={`${base}/video/cruise-1080.mp4`}
      data-src-mobile={`${base}/video/cruise-720.mp4`}
    ></video>
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,21,38,0.85)_0%,rgba(7,21,38,0.45)_45%,rgba(7,21,38,0.05)_75%)] max-md:bg-[linear-gradient(180deg,rgba(7,21,38,0.35)_0%,rgba(7,21,38,0.15)_35%,rgba(7,21,38,0.92)_75%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#071526]/80 to-transparent"></div>
  </div>

  <div class="mx-auto flex w-full max-w-[1240px] flex-1 flex-col justify-end px-5 pt-28 pb-8 sm:px-8 md:justify-center md:pb-16">
    <div class="grid items-center gap-10 lg:grid-cols-[1.25fr_1fr]">
      <div>
        <p class="v3-fade inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1.5 text-xs font-semibold tracking-wide backdrop-blur-md">
          <span class="relative inline-block h-2 w-2 rounded-full bg-brand text-brand live-dot"></span>
          Клуб путешествий inCruises · с 2015 года
        </p>
        <h1 class="mt-6 text-[clamp(2.4rem,5.6vw,4.6rem)] leading-[1.02] font-extrabold tracking-[-0.045em] text-balance" data-split="now" data-split-delay="0.3">
          Круизы по&nbsp;всему миру <span class="text-brand">на&nbsp;клубных условиях</span>
        </h1>
        <p class="v3-fade mt-6 max-w-[520px] text-[clamp(1rem,1.4vw,1.2rem)] leading-relaxed text-white/80">
          Ответьте на&nbsp;4 вопроса — подберём план членства и&nbsp;посчитаем вашу выгоду. Это займёт меньше минуты.
        </p>
        <div class="v3-fade mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#quiz" class="v3-btn bg-brand text-white shadow-[0_14px_40px_-12px_rgba(247,148,29,0.9)] hover:bg-brand-600">
            Подобрать план за&nbsp;1&nbsp;минуту <Icon name="arrow" size={18} />
          </a>
          <a href="#how" class="v3-btn border border-white/30 bg-white/10 text-white backdrop-blur-md hover:bg-white/20">Как это работает</a>
        </div>
      </div>

      <!-- Карточка-превью квиза (десктоп) -->
      <a href="#quiz" class="v3-fade group hidden rounded-[28px] border border-white/15 bg-white/10 p-6 backdrop-blur-2xl transition hover:bg-white/15 lg:block">
        <div class="flex items-center justify-between text-xs font-semibold text-white/70">
          <span>Подбор плана</span><span>Шаг 1 из 4</span>
        </div>
        <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white/15"><div class="h-full w-1/4 rounded-full bg-brand"></div></div>
        <p class="mt-6 text-2xl font-bold tracking-tight">Что для вас важнее?</p>
        <div class="mt-5 space-y-2.5">
          {
            ['Путешествовать выгоднее', 'Путешествовать и зарабатывать', 'Пока просто изучаю'].map((t, i) => (
              <div class:list={['flex items-center justify-between rounded-2xl px-4 py-3.5 text-[15px] font-semibold', i === 0 ? 'bg-white text-[#071526]' : 'bg-white/10']}>
                {t}
                <Icon name="chevron" size={18} class={i === 0 ? 'text-brand' : 'text-white/50'} />
              </div>
            ))
          }
        </div>
        <p class="mt-5 text-center text-sm font-semibold text-brand transition group-hover:translate-x-1">Начать →</p>
      </a>
    </div>

    <!-- Доверие -->
    <div class="v3-fade mt-10 grid grid-cols-3 gap-2 border-t border-white/15 pt-6 text-center sm:max-w-[620px] sm:text-left md:mt-16">
      <div>
        <p class="text-2xl font-extrabold tracking-tight sm:text-3xl"><span data-count="193" data-delay="900">193</span></p>
        <p class="text-[11px] font-semibold text-white/60 sm:text-xs">страны</p>
      </div>
      <div>
        <p class="text-2xl font-extrabold tracking-tight sm:text-3xl"><span data-count="21000" data-suffix="+" data-delay="1000">21 000+</span></p>
        <p class="text-[11px] font-semibold text-white/60 sm:text-xs">круизов</p>
      </div>
      <div>
        <p class="text-2xl font-extrabold tracking-tight sm:text-3xl"><span data-count={guests.value} data-delay="1100">{fmt(guests.value)}</span></p>
        <p class="text-[11px] font-semibold text-white/60 sm:text-xs">гостей с 2016 г.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, reduce } from '../../scripts/motion';
  const v = document.getElementById('v3-video') as HTMLVideoElement;
  // Лёгкая версия видео для телефонов, Full HD — для больших экранов
  const src = matchMedia('(min-width: 1024px)').matches ? v.dataset.srcDesktop! : v.dataset.srcMobile!;
  const saveData = (navigator as any).connection?.saveData;
  if (reduce || saveData) {
    v.removeAttribute('autoplay');
  } else {
    v.src = src;
    v.play().catch(() => {});
  }
  if (!reduce) {
    gsap.from('.v3-fade', { opacity: 0, y: 24, duration: 1.2, ease: 'expo.out', stagger: 0.1, delay: 0.5 });
    gsap.to(v, { scale: 1.18, ease: 'none', scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: true } });
  }
</script>
