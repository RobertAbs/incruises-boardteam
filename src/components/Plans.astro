---
import Icon from './art/Icon.astro';
import { plans } from '../data/content';
import { contactLink } from '../config';
const fmt = (n: number) => n.toLocaleString('ru-RU');
const first = plans[0];
---

<section id="plans" class="grain relative overflow-hidden bg-ink py-[clamp(72px,10vw,140px)] text-white">
  <div class="pointer-events-none absolute -right-40 bottom-0 h-[600px] w-[600px] rounded-full bg-brand/15 blur-[120px]"></div>
  <div class="pointer-events-none absolute -top-40 -left-40 h-[500px] w-[500px] rounded-full bg-sea/20 blur-[120px]"></div>

  <div class="container-x relative">
    <div class="mb-10 flex flex-col justify-between gap-8 md:mb-14 lg:flex-row lg:items-end">
      <div class="max-w-[720px]">
        <p class="eyebrow mb-5 bg-white/10 text-brand" data-reveal><Icon name="coins" size={14} /> Калькулятор выгоды</p>
        <h2 class="h-section" data-split>Как работает клубная экономия</h2>
        <p class="lead mt-5 text-white/65" data-reveal>
          Членские взносы превращаются в&nbsp;бонусные баллы (ББ), а&nbsp;баллами оплачивается до&nbsp;половины стоимости круиза.
        </p>
      </div>

      <div role="tablist" aria-label="План членства" class="inline-flex shrink-0 self-start rounded-full border border-white/10 bg-white/5 p-1.5 lg:self-auto" data-reveal>
        {
          plans.map((p, i) => (
            <button
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-plan-tab={p.id}
              class="plan-tab flex items-center gap-2.5 rounded-full px-5 py-3 text-sm font-bold transition-colors duration-300 aria-selected:bg-white aria-selected:text-ink"
            >
              <span
                class:list={[
                  'grid h-7 w-7 place-items-center rounded-full font-display text-xs font-black',
                  p.id === 'classic' ? 'bg-gradient-to-br from-[#ffe08a] to-gold text-[#6b4b00]' : 'bg-gradient-to-br from-[#5b5f68] to-[#15171b] text-white',
                ]}
              >
                {p.letter}
              </span>
              План {p.name}
            </button>
          ))
        }
      </div>
    </div>

    <script type="application/json" id="plans-data" set:html={JSON.stringify(plans)} />

    <div class="grid gap-5 lg:grid-cols-[1fr_1.15fr]">
      <!-- Левая колонка: взносы -->
      <div class="card-glass flex flex-col p-6 sm:p-8" data-reveal>
        <div class="flex items-center justify-between">
          <p class="font-display text-lg font-bold">Ваши членские взносы</p>
          <button id="plan-play" class="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-bold tracking-wider uppercase transition hover:bg-white/20">
            <Icon name="play" size={12} /> Проиграть
          </button>
        </div>

        <ol id="plan-steps" class="mt-6 space-y-2" aria-live="polite">
          {
            first.steps.map((s, i) => (
              <li class="plan-step flex items-center justify-between gap-4 rounded-2xl border border-white/8 bg-white/[0.03] px-4 py-3 transition-all duration-500" data-i={i}>
                <span class="flex items-center gap-3">
                  <span class="step-dot grid h-7 w-7 place-items-center rounded-full bg-white/10 text-xs font-bold">{i + 1}</span>
                  <span class="text-sm font-semibold text-white/80">{s.label}</span>
                </span>
                <span class="flex items-center gap-2 text-sm font-bold">
                  <span>{fmt(s.usd)} $</span>
                  <Icon name="arrow" size={14} class="text-white/40" />
                  <span class="text-brand">{fmt(s.bb)} ББ</span>
                </span>
              </li>
            ))
          }
        </ol>

        <div class="mt-6">
          <label for="plan-range" class="flex items-center justify-between text-xs font-bold tracking-wider text-white/50 uppercase">
            <span>Прогресс оплаты</span>
            <span id="plan-range-label">Шаг {first.steps.length} из {first.steps.length}</span>
          </label>
          <input
            id="plan-range"
            type="range"
            min="0"
            max={first.steps.length}
            value={first.steps.length}
            class="mt-3 h-2 w-full cursor-pointer appearance-none rounded-full bg-white/10 accent-brand"
          />
        </div>

        <div class="mt-6 grid grid-cols-2 gap-3 border-t border-white/10 pt-6">
          <div>
            <p class="text-xs font-bold tracking-wider text-white/50 uppercase">Оплачено взносов</p>
            <p class="num mt-1 text-3xl"><span id="o-paid" data-suffix=" $">{fmt(first.usdInMembership)} $</span></p>
          </div>
          <div class="relative">
            <p class="text-xs font-bold tracking-wider text-white/50 uppercase">Начислено баллов</p>
            <p class="num mt-1 text-3xl text-brand"><span id="o-bb" data-suffix=" ББ">{fmt(first.bbTotal)} ББ</span></p>
            <span id="bb-pop" class="pointer-events-none absolute top-0 right-0 text-sm font-bold text-brand opacity-0"></span>
          </div>
        </div>
      </div>

      <!-- Правая колонка: круиз -->
      <div class="relative flex flex-col overflow-hidden rounded-4xl bg-white p-6 text-ink sm:p-8" data-reveal>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-xs font-bold tracking-[0.18em] text-muted uppercase">Пример</p>
            <p class="mt-1 font-display text-2xl font-bold">Круиз на двоих</p>
          </div>
          <p class="num text-5xl"><span id="o-cruise" data-suffix=" $">{fmt(first.cruise)} $</span></p>
        </div>

        <!-- Полоса стоимости круиза -->
        <div class="mt-8">
          <div class="flex h-16 overflow-hidden rounded-2xl bg-paper ring-1 ring-ink/5">
            <div id="bar-bb" class="relative flex items-center overflow-hidden bg-gradient-to-r from-brand to-[#ff7a3d] text-white transition-[width] duration-700 ease-(--ease-out-expo)" style={`width:${(first.bbTotal / first.cruise) * 100}%`}>
              <span class="px-4 text-sm font-bold whitespace-nowrap">Баллами</span>
              <span class="absolute inset-0 bg-[linear-gradient(110deg,transparent_35%,rgba(255,255,255,0.35)_50%,transparent_65%)] bg-[length:250%_100%] [animation:shimmer_2.8s_linear_infinite]"></span>
            </div>
            <div class="flex flex-1 items-center justify-end bg-gradient-to-r from-ocean to-sea px-4 text-sm font-bold text-white">Деньгами</div>
          </div>
          <div class="mt-3 flex justify-between text-sm font-bold">
            <span class="text-brand-600"><span id="o-bbpart" data-suffix=" ББ">{fmt(first.bbTotal)} ББ</span></span>
            <span class="text-ocean"><span id="o-cash" data-suffix=" $">{fmt(first.cashPart)} $</span></span>
          </div>
        </div>

        <div class="mt-8 grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl bg-paper p-4">
            <p class="text-xs font-bold tracking-wider text-muted uppercase">Взносы</p>
            <p class="num mt-1 text-2xl"><span id="o-paid2" data-suffix=" $">{fmt(first.usdInMembership)} $</span></p>
          </div>
          <div class="rounded-2xl bg-paper p-4">
            <p class="text-xs font-bold tracking-wider text-muted uppercase">Из собственных средств</p>
            <p class="num mt-1 text-2xl"><span id="o-own" data-suffix=" $">{fmt(first.own)} $</span></p>
          </div>
          <div class="relative overflow-hidden rounded-2xl bg-ink p-4 text-white">
            <div class="absolute -top-6 -right-6 h-20 w-20 rounded-full bg-brand/50 blur-2xl"></div>
            <p class="relative text-xs font-bold tracking-wider text-white/60 uppercase">Ваша выгода</p>
            <p class="num relative mt-1 text-2xl text-brand"><span id="o-benefit" data-suffix=" $">{fmt(first.benefit)} $</span></p>
          </div>
        </div>

        <p class="mt-6 text-xs leading-relaxed text-muted">
          Расчёт по примеру из презентации: 1&nbsp;ББ используется как 1&nbsp;$ при оплате круиза. Конкретные условия начисления и&nbsp;использования баллов
          зависят от действующих правил программы inCruises.
        </p>
        <a href={contactLink()} class="btn-brand mt-6 self-start">Подобрать план <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </div>
</section>

<script>
  import { ScrollTrigger, reduce, makeFlow } from '../scripts/motion';
  import type { Plan } from '../data/content';

  const plans: Plan[] = JSON.parse(document.getElementById('plans-data')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const stepsEl = $('plan-steps');
  const range = $('plan-range') as HTMLInputElement;
  const rangeLabel = $('plan-range-label');
  const bar = $('bar-bb');
  const pop = $('bb-pop');
  const fmt = (n: number) => n.toLocaleString('ru-RU');

  const ids = ['o-paid', 'o-bb', 'o-cruise', 'o-bbpart', 'o-cash', 'o-paid2', 'o-own', 'o-benefit'] as const;
  const flows = Object.fromEntries(ids.map((id) => [id, makeFlow($(id))])) as Record<(typeof ids)[number], ReturnType<typeof makeFlow>>;

  let plan = plans[0];
  let step = plan.steps.length;
  let timer: number | undefined;

  const renderSteps = () => {
    stepsEl.innerHTML = plan.steps
      .map(
        (s, i) => `<li class="plan-step flex items-center justify-between gap-4 rounded-2xl border border-white/8 bg-white/[0.03] px-4 py-3 transition-all duration-500" data-i="${i}">
          <span class="flex items-center gap-3"><span class="step-dot grid h-7 w-7 place-items-center rounded-full bg-white/10 text-xs font-bold">${i + 1}</span><span class="text-sm font-semibold text-white/80">${s.label}</span></span>
          <span class="flex items-center gap-2 text-sm font-bold"><span>${fmt(s.usd)} $</span><span class="text-white/40">→</span><span class="text-brand">${fmt(s.bb)} ББ</span></span></li>`,
      )
      .join('');
    range.max = String(plan.steps.length);
  };

  const update = (k: number, withPop = false) => {
    const prev = step;
    step = k;
    const done = plan.steps.slice(0, k);
    const paid = done.reduce((a, s) => a + s.usd, 0);
    const bb = done.reduce((a, s) => a + s.bb, 0);
    const cash = plan.cruise - bb;
    const own = paid + cash;
    const benefit = Math.max(0, bb - paid);

    flows['o-paid'].update(paid);
    flows['o-paid2'].update(paid);
    flows['o-bb'].update(bb);
    flows['o-bbpart'].update(bb);
    flows['o-cash'].update(cash);
    flows['o-own'].update(own);
    flows['o-benefit'].update(benefit);
    flows['o-cruise'].update(plan.cruise);
    bar.style.width = `${(bb / plan.cruise) * 100}%`;

    stepsEl.querySelectorAll<HTMLElement>('.plan-step').forEach((li, i) => {
      const on = i < k;
      li.classList.toggle('!bg-brand/15', on);
      li.classList.toggle('!border-brand/40', on);
      li.classList.toggle('opacity-50', !on);
      const dot = li.querySelector<HTMLElement>('.step-dot')!;
      dot.classList.toggle('!bg-brand', on);
      dot.textContent = on ? '✓' : String(i + 1);
    });
    range.value = String(k);
    rangeLabel.textContent = `Шаг ${k} из ${plan.steps.length}`;

    if (withPop && k > prev && !reduce) {
      pop.textContent = `+${fmt(plan.steps[k - 1].bb)} ББ`;
      pop.animate(
        [
          { opacity: 0, transform: 'translateY(14px) scale(.8)' },
          { opacity: 1, transform: 'translateY(-6px) scale(1)', offset: 0.3 },
          { opacity: 0, transform: 'translateY(-28px) scale(1)' },
        ],
        { duration: 900, easing: 'cubic-bezier(.16,1,.3,1)' },
      );
    }
  };

  const play = () => {
    clearInterval(timer);
    update(0);
    if (reduce) return update(plan.steps.length);
    let k = 0;
    timer = window.setInterval(() => {
      k += 1;
      update(k, true);
      if (k >= plan.steps.length) clearInterval(timer);
    }, 750);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-plan-tab]').forEach((btn) =>
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-plan-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      plan = plans.find((p) => p.id === btn.dataset.planTab)!;
      renderSteps();
      play();
    }),
  );
  range.addEventListener('input', () => {
    clearInterval(timer);
    update(Number(range.value), true);
  });
  $('plan-play').addEventListener('click', play);

  renderSteps();
  update(0);
  ScrollTrigger.create({ trigger: '#plan-steps', start: 'top 75%', once: true, onEnter: play });
</script>
