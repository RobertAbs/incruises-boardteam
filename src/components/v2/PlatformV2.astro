---
import { Picture } from 'astro:assets';
import shipSea from '../../assets/v2/ship-sea.jpg';
import island from '../../assets/v2/island.jpg';
import colosseum from '../../assets/v2/colosseum.jpg';
import { platform } from '../../data/content';
const fmt = (n: number) => n.toLocaleString('ru-RU');
const photos = [
  { src: shipSea, alt: 'Круизный лайнер в открытом море', pos: 'object-[30%_50%]' },
  { src: island, alt: 'Остров с монастырём посреди бирюзового озера', pos: 'object-center' },
  { src: colosseum, alt: 'Колизей в Риме на закате', pos: 'object-[55%_50%]' },
];
---

<section id="platform" class="relative bg-onyx py-[clamp(90px,12vw,180px)] text-ivory">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <div class="max-w-[760px]">
        <p class="v2-eyebrow mb-10" data-reveal>inCruises · inStays · inTours</p>
        <h2 class="v2-h" data-split>Собственная платформа <em class="text-champagne-2 italic">бронирования</em></h2>
      </div>
      <p class="v2-lead max-w-[380px] text-ivory/60" data-reveal>Круизы, отели и&nbsp;туры — в&nbsp;одном приложении, по&nbsp;клубным ценам и&nbsp;без скрытых расходов.</p>
    </div>

    <div class="mt-[clamp(50px,7vw,90px)] grid gap-5 md:grid-cols-3 md:gap-6">
      {
        platform.map((p, i) => (
          <a href="#plans" class:list={['group relative block overflow-hidden', i === 1 && 'md:mt-16']} data-mask>
            <div class="aspect-[3/4] overflow-hidden">
              <Picture
                src={photos[i].src}
                alt={photos[i].alt}
                widths={[480, 900]}
                sizes="(min-width:768px) 32vw, 100vw"
                formats={['avif', 'webp']}
                class={`h-full w-full object-cover transition-transform duration-[1.6s] ease-(--ease-out-expo) group-hover:scale-105 ${photos[i].pos}`}
              />
            </div>
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(11,12,15,0.35)_0%,transparent_35%,rgba(11,12,15,0.9)_100%)]" />
            <div class="absolute inset-x-0 top-0 flex items-center justify-between p-6">
              <span class="font-inter text-[11px] tracking-[0.28em] text-ivory/80 uppercase">0{i + 1} — {p.tab}</span>
              <span class="font-serif text-lg italic">
                in<span class="not-italic">{p.brand}</span>
              </span>
            </div>
            <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
              {p.pre && <p class="font-inter text-[11px] tracking-[0.24em] text-ivory/60 uppercase">{p.pre}</p>}
              <p class="v2-num text-[clamp(3rem,4.6vw,4.4rem)] leading-none text-champagne-2">
                <span data-count={p.value} data-delay={i * 150}>
                  {fmt(p.value)}
                </span>
              </p>
              <p class="mt-3 max-w-[260px] font-inter text-sm leading-relaxed font-light text-ivory/80">{p.headline}</p>
              <span class="mt-6 inline-flex items-center gap-3 font-inter text-[11px] tracking-[0.24em] text-champagne uppercase">
                Подробнее
                <span class="h-px w-8 bg-champagne transition-all duration-500 group-hover:w-14" />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
