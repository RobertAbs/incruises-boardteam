---
import { savings } from '../../data/content';
---

<section id="savings" class="relative bg-ivory py-[clamp(90px,12vw,180px)] text-onyx">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <div class="max-w-[900px]">
      <p class="v2-eyebrow mb-10 !text-[#9a7b3f]" data-reveal>Клубная выгода</p>
      <h2 class="v2-h" data-split>С&nbsp;2015 года inCruises делает роскошные путешествия <em class="text-[#9a7b3f] italic">более&nbsp;…</em></h2>
    </div>

    <div class="mt-[clamp(60px,8vw,110px)] grid border-t border-onyx/15 lg:grid-cols-3">
      {
        savings.map((s, i) => (
          <article class:list={['group relative flex flex-col pt-10 pb-12 lg:px-10', i > 0 && 'border-t border-onyx/15 lg:border-t-0 lg:border-l', i === 0 && 'lg:pl-0']} data-reveal>
            <p class="font-serif text-3xl font-light italic">{s.word}</p>
            <p class="mt-1 font-inter text-[11px] tracking-[0.22em] text-onyx/50 uppercase">{s.caption}</p>

            <p class="v2-num mt-10 flex items-baseline text-[clamp(5rem,9vw,8.5rem)] leading-[0.85]">
              <span class="mr-3 font-inter text-sm font-normal tracking-[0.2em] text-onyx/50 uppercase">{s.prefix}</span>
              {s.from && <span class="text-[0.55em] text-onyx/40">{s.from}–</span>}
              <span data-count={s.to} data-suffix="%" data-delay={i * 200} class:list={[i === 2 && 'text-[#9a7b3f]']}>
                {s.to}%
              </span>
            </p>

            <div class="mt-10 h-px w-full overflow-hidden bg-onyx/10">
              <div class="v2-bar h-full origin-left bg-gradient-to-r from-[#9a7b3f] to-champagne" style={`--w:${s.to / 100}`} />
            </div>

            <p class="mt-8 font-serif text-2xl leading-tight">{s.title}</p>
            <p class="v2-lead mt-2 text-onyx/60">{s.text}</p>

            {i === 2 && (
              <div class="mt-10 h-36 w-60 -rotate-3 self-start overflow-hidden rounded-xl bg-[linear-gradient(135deg,#2d2d31,#0b0b0d_60%,#1e1e22)] p-5 shadow-[0_30px_60px_-20px_rgba(0,0,0,0.6)] ring-1 ring-black/40 transition-transform duration-700 group-hover:rotate-0">
                <div class="flex items-center justify-between">
                  <span class="font-inter text-[9px] tracking-[0.3em] text-champagne/80 uppercase">inCruises</span>
                  <span class="grid h-7 w-7 place-items-center rounded-full border border-champagne/70 font-inter text-[9px] font-semibold text-champagne">RP</span>
                </div>
                <div class="mt-5 h-7 w-10 rounded-md bg-gradient-to-br from-champagne-2 to-[#8f7136]" />
                <p class="mt-3 font-serif text-lg text-champagne-2 italic">Black card</p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap, reduce } from '../../scripts/motion';
  document.querySelectorAll<HTMLElement>('.v2-bar').forEach((b, i) => {
    const w = Number(b.style.getPropertyValue('--w'));
    if (reduce) return gsap.set(b, { scaleX: w });
    gsap.fromTo(b, { scaleX: 0 }, { scaleX: w, duration: 2.4, delay: i * 0.2, ease: 'expo.out', scrollTrigger: { trigger: b, start: 'top 90%', once: true } });
  });
</script>
