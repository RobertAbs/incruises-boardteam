---
import Icon from './art/Icon.astro';
import { partnerTiers, earnings } from '../data/content';

const coinStyle: Record<string, string> = {
  starter: 'from-[#ffffff] via-[#e6e9ee] to-[#b9c0cb] text-[#5b6472]',
  classic: 'from-[#fff1b8] via-[#f3cf62] to-[#c9971f] text-[#6b4b00]',
  premium: 'from-[#6b707a] via-[#2b2e34] to-[#0c0d10] text-white',
};
---

<section id="partner" class="relative overflow-hidden bg-paper py-[clamp(72px,10vw,140px)]">
  <div class="container-x">
    <div class="grid items-end gap-8 lg:grid-cols-[1.7fr_1fr]">
      <div>
        <p class="eyebrow mb-5 bg-brand/10 text-brand-600" data-reveal>Партнёрство</p>
        <h2 class="h-section" data-split>Станьте членом-партнёром клуба</h2>
      </div>
      <p class="lead text-muted" data-reveal>
        Добавьте <b class="text-ink">+$95</b> к&nbsp;любому членству и&nbsp;откройте полный доступ к&nbsp;возможностям получения дохода в&nbsp;долларах.
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {
        partnerTiers.map((t, i) => (
          <article class="tier card relative flex flex-col items-center overflow-hidden px-6 pt-10 pb-8 text-center" data-reveal data-tilt="6">
            <div class="relative h-40 w-40">
              <div
                class={`coin absolute inset-0 grid place-items-center rounded-full bg-gradient-to-br shadow-[inset_0_-8px_16px_rgba(0,0,0,0.18),inset_0_6px_12px_rgba(255,255,255,0.6),0_24px_40px_-18px_rgba(6,21,43,0.5)] ${coinStyle[t.id]}`}
              >
                <div class="absolute inset-3 rounded-full border-2 border-current opacity-20" />
                <span class="font-display text-6xl font-black opacity-90">{t.letter}</span>
              </div>
              <div class="plus95 absolute -right-6 -bottom-2 grid h-20 w-20 place-items-center rounded-full bg-gradient-to-br from-sea to-ocean font-display text-lg font-black text-white shadow-[0_14px_30px_-10px_rgba(15,95,181,0.8)] ring-4 ring-white">
                +$95
              </div>
            </div>

            <p class="mt-8 text-sm font-bold tracking-[0.2em] text-muted uppercase">{t.name}</p>
            <p class="num mt-2 text-5xl">
              <span class="tier-sum" data-base={t.base} data-total={t.total} data-prefix="$">${t.total}</span>
            </p>
            <p class="mt-2 text-sm text-muted">
              членство ${t.base} + партнёрство $95
            </p>
          </article>
        ))
      }
    </div>
    <p class="mt-5 text-center text-sm font-semibold text-muted" data-reveal>Партнёрство оплачивается каждые 6 месяцев</p>

    <div class="mt-14 overflow-hidden rounded-5xl bg-gradient-to-br from-ocean to-deep p-7 text-white sm:p-10" data-reveal>
      <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
        <p class="font-display text-3xl font-bold sm:text-4xl">Зарабатывайте:</p>
        <ul class="flex flex-wrap gap-3">
          {
            earnings.map((e, i) => (
              <li
                class:list={[
                  'earn-chip flex items-center gap-2 rounded-full px-5 py-3 font-bold',
                  i === earnings.length - 1 ? 'bg-brand text-white' : 'bg-white/10 text-white',
                ]}
              >
                <Icon name={i === earnings.length - 1 ? 'ship' : 'coins'} size={18} />
                {e}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, reduce, makeFlow } from '../scripts/motion';

  document.querySelectorAll<HTMLElement>('.tier').forEach((tier, i) => {
    const sum = tier.querySelector<HTMLElement>('.tier-sum')!;
    const flow = makeFlow(sum);
    const base = Number(sum.dataset.base);
    const total = Number(sum.dataset.total);
    const plus = tier.querySelector<HTMLElement>('.plus95')!;
    const coin = tier.querySelector<HTMLElement>('.coin')!;
    flow.animated = false;
    flow.update(reduce ? total : base);
    requestAnimationFrame(() => (flow.animated = true));
    if (reduce) return;

    gsap.set(plus, { x: 90, y: -120, scale: 0.4, opacity: 0, rotate: -90 });
    ScrollTrigger.create({
      trigger: tier,
      start: 'top 75%',
      once: true,
      onEnter: () => {
        gsap
          .timeline({ delay: 0.25 + i * 0.2 })
          .to(plus, { x: 0, y: 0, scale: 1, opacity: 1, rotate: 0, duration: 1, ease: 'back.out(1.6)' })
          .to(coin, { scale: 1.08, duration: 0.18, yoyo: true, repeat: 1, ease: 'power2.out' }, '-=0.25')
          .add(() => flow.update(total), '-=0.3');
      },
    });
  });

  if (!reduce) {
    gsap.from('.earn-chip', { y: 20, opacity: 0, stagger: 0.08, duration: 0.8, ease: 'expo.out', scrollTrigger: { trigger: '.earn-chip', start: 'top 90%', once: true } });
  }
</script>
