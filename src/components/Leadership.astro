---
import Icon from './art/Icon.astro';
import { leadership, leadershipColumns } from '../data/content';
const hasHeaders = leadershipColumns.some(Boolean);
---

<section id="leadership" class="relative overflow-hidden bg-paper py-[clamp(72px,10vw,140px)]">
  <div class="container-x">
    <div class="mb-12 grid items-end gap-8 md:mb-16 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow mb-5 bg-ocean/10 text-ocean" data-reveal><Icon name="trophy" size={14} /> Карьерная лестница</p>
        <h2 class="h-section" data-split>Командный лидерский бонус</h2>
        <p class="mt-4 font-display text-xl font-bold text-ocean sm:text-2xl" data-reveal>до&nbsp;100% экономии на&nbsp;круизы</p>
      </div>
      <!-- Карты -->
      <div class="relative hidden h-56 lg:block" aria-hidden="true" data-reveal>
        <div class="float-card absolute top-0 right-24 h-44 w-72 rotate-[-8deg] overflow-hidden rounded-3xl bg-[linear-gradient(135deg,#6fd8ff_0%,#149fe0_35%,#0d3466_100%)] p-5 text-white shadow-[0_30px_60px_-20px_rgba(15,95,181,0.7)]">
          <div class="absolute -right-8 -bottom-10 h-36 w-36 rounded-full bg-white/20 blur-2xl"></div>
          <div class="flex items-center justify-between">
            <span class="rounded-md bg-brand px-1.5 py-0.5 font-serif text-sm font-bold italic">in</span>
            <span class="text-sm font-bold">Cruises</span>
          </div>
          <div class="mt-6 h-8 w-11 rounded-md bg-gradient-to-br from-[#ffe08a] to-gold"></div>
          <p class="absolute right-5 bottom-4 font-black tracking-wider italic">VISA</p>
        </div>
        <div class="float-card absolute top-10 right-0 h-44 w-72 rotate-[6deg] overflow-hidden rounded-3xl bg-gradient-to-br from-[#3a3a3f] via-[#121214] to-black p-5 text-white shadow-[0_30px_60px_-20px_rgba(0,0,0,0.8)] ring-1 ring-white/10">
          <p class="text-[10px] font-bold tracking-[0.3em] text-white/60 uppercase">inCruises International</p>
          <div class="mt-5 h-8 w-11 rounded-md bg-gradient-to-br from-[#ffe08a] to-gold"></div>
          <p class="absolute bottom-4 left-5 text-[11px] font-bold tracking-[0.2em] text-gold uppercase">Black card</p>
        </div>
      </div>
    </div>

    {
      hasHeaders && (
        <div class="mb-3 hidden grid-cols-[minmax(0,1.6fr)_repeat(4,minmax(0,1fr))] gap-4 px-6 text-xs font-bold tracking-wider text-muted uppercase md:grid">
          <span>Ранг</span>
          {leadershipColumns.map((c) => (
            <span>{c}</span>
          ))}
        </div>
      )
    }

    <ol class="space-y-3">
      {
        leadership.map((r) => (
          <li
            class="lead-row group relative overflow-hidden rounded-3xl bg-white shadow-[0_1px_0_rgba(6,21,43,0.04),0_14px_34px_-22px_rgba(6,21,43,0.35)] ring-1 ring-ink/5"
            style={`--c:${r.color}`}
          >
            <span class="absolute inset-y-0 right-0 w-2 bg-(--c) transition-[width] duration-500 group-hover:w-4" />
            <span class="absolute inset-y-0 left-0 w-1/3 bg-gradient-to-r from-(--c)/12 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
            <div class="relative grid grid-cols-2 items-center gap-x-4 gap-y-2 px-5 py-4 pr-8 md:grid-cols-[minmax(0,1.6fr)_repeat(4,minmax(0,1fr))] md:px-6">
              <div class="col-span-2 flex items-center gap-4 md:col-span-1">
                <span class="relative grid h-12 w-12 shrink-0 place-items-center">
                  <svg viewBox="0 0 48 48" class="absolute inset-0 h-full w-full" aria-hidden="true">
                    <path d="M24 2l19 11v22L24 46 5 35V13z" fill="var(--c)" />
                    <path d="M24 6l15.5 9v18L24 42 8.5 33V15z" fill="none" stroke="white" stroke-opacity=".5" stroke-width="1.5" />
                  </svg>
                  <span class="relative font-serif text-base font-bold text-white italic">in</span>
                  {r.crown && <span class="absolute -top-2 text-sm text-gold">★</span>}
                </span>
                <span class="font-display text-[15px] leading-tight font-bold">{r.rank}</span>
              </div>
              {r.values.map((v, j) => (
                <span class:list={['num text-lg md:text-xl', j === 3 ? 'text-muted' : '']} style={j < 3 ? 'color: var(--c)' : undefined}>
                  {v}
                </span>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { gsap, reduce } from '../scripts/motion';
  if (!reduce) {
    const rows = gsap.utils.toArray<HTMLElement>('.lead-row').reverse();
    gsap.from(rows, {
      xPercent: 12,
      opacity: 0,
      duration: 0.9,
      ease: 'expo.out',
      stagger: 0.1,
      scrollTrigger: { trigger: '.lead-row', start: 'top 85%', once: true },
    });
    gsap.to('.float-card', { y: -10, duration: 2.6, ease: 'sine.inOut', yoyo: true, repeat: -1, stagger: 0.6 });
  }
</script>
