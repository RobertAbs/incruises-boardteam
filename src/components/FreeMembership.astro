---
import Icon from './art/Icon.astro';
const payments = Array.from({ length: 5 }, (_, i) => i + 1);
---

<section id="free" class="relative overflow-hidden bg-sand py-[clamp(72px,10vw,140px)]">
  <div class="container-x">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow mb-5 bg-brand/10 text-brand-600" data-reveal><Icon name="gift" size={14} /> Бесплатное членство</p>
        <h2 class="h-section" data-split>До&nbsp;<span class="text-gradient-brand">50% экономии</span> на&nbsp;круизы</h2>
        <p class="lead mt-6 text-muted" data-reveal>
          Каждый раз, когда вы делаете <b class="text-ink">$500 прямого оборота</b>, inCruises ежемесячно начисляет на&nbsp;ваш счёт
          <b class="text-ink">200 бонусных баллов</b>.
        </p>

        <!-- Бейдж -->
        <div class="relative mt-10 hidden h-44 w-44 lg:block" data-reveal>
          <svg viewBox="0 0 200 200" class="badge-spin absolute inset-0 h-full w-full" aria-hidden="true">
            <defs><path id="circ" d="M100 100 m-78 0 a78 78 0 1 1 156 0 a78 78 0 1 1 -156 0"></path></defs>
            <text font-family="Unbounded Variable, sans-serif" font-size="13" font-weight="700" letter-spacing="4" fill="#0a2244">
              <textPath href="#circ">FREE MEMBERSHIP · FREE MEMBERSHIP · </textPath>
            </text>
          </svg>
          <div class="absolute inset-9 grid place-items-center rounded-full bg-gradient-to-br from-brand to-[#ff6a3d] text-white shadow-xl">
            <span class="num text-2xl">200&nbsp;ББ</span>
          </div>
        </div>
      </div>

      <div id="free-demo" class="card relative overflow-hidden p-6 sm:p-9" data-reveal>
        <p class="text-xs font-bold tracking-[0.18em] text-muted uppercase">Пример</p>
        <p class="mt-1 font-display text-2xl font-bold">Круиз 2&nbsp;000&nbsp;$ на&nbsp;двоих</p>

        <ul class="mt-6 space-y-2.5">
          {
            payments.map((n) => (
              <li class="free-row flex items-center justify-between rounded-2xl bg-paper px-4 py-3">
                <span class="relative font-bold text-muted">
                  {n}. 100 $
                  <svg class="pointer-events-none absolute top-1/2 -left-1 h-3 w-[calc(100%+8px)] -translate-y-1/2 overflow-visible" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
                    <path class="strike" d="M0 6 Q 50 2 100 5" fill="none" stroke="#e0174f" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
                  </svg>
                </span>
                <span class="free-bb flex items-center gap-2 font-bold text-brand-600">
                  <Icon name="gift" size={16} /> 200 ББ бесплатно
                </span>
              </li>
            ))
          }
        </ul>

        <div class="mt-6 flex items-center gap-4 rounded-3xl bg-ink p-5 text-white">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white/10 text-brand"><Icon name="card" size={24} /></span>
          <div class="flex-1">
            <p class="text-sm text-white/60">1 000 ББ + доплата</p>
            <p class="num text-3xl"><span id="free-total" data-prefix="" data-suffix=" $">1 000 $</span></p>
          </div>
          <span class="eyebrow bg-brand text-white">−50%</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, reduce, makeFlow } from '../scripts/motion';
  const flow = makeFlow(document.getElementById('free-total')!);
  flow.animated = false;
  flow.update(reduce ? 1000 : 2000);
  requestAnimationFrame(() => (flow.animated = true));

  if (!reduce) {
    gsap.to('.badge-spin', { rotate: 360, duration: 24, repeat: -1, ease: 'none', transformOrigin: '50% 50%' });
    gsap.set('.strike', { drawSVG: '0%' });
    gsap.set('.free-bb', { opacity: 0, x: 20 });
    ScrollTrigger.create({
      trigger: '#free-demo',
      start: 'top 70%',
      once: true,
      onEnter: () => {
        const tl = gsap.timeline({ delay: 0.3 });
        document.querySelectorAll('.free-row').forEach((row, i) => {
          tl.to(row.querySelector('.strike'), { drawSVG: '100%', duration: 0.35, ease: 'power2.out' }, i * 0.35).to(
            row.querySelector('.free-bb'),
            { opacity: 1, x: 0, duration: 0.5, ease: 'back.out(2)' },
            i * 0.35 + 0.15,
          );
        });
        tl.add(() => flow.update(1000));
      },
    });
  }
</script>
