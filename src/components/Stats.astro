---
import Icon from './art/Icon.astro';
import { stats, guests } from '../data/content';
const fmt = (n: number) => n.toLocaleString('ru-RU');
---

<section id="numbers" class="relative bg-paper py-[clamp(72px,10vw,140px)]">
  <div class="container-x">
    <div class="mb-12 flex flex-col justify-between gap-6 md:mb-16 md:flex-row md:items-end">
      <div>
        <p class="eyebrow mb-5 bg-brand/10 text-brand-600" data-reveal>С 2015 года</p>
        <h2 class="h-section max-w-[720px]" data-split>inCruises в&nbsp;цифрах</h2>
      </div>
      <p class="flex items-center gap-3 text-sm font-semibold text-muted" data-reveal>
        <span class="relative inline-block h-2.5 w-2.5 rounded-full bg-emerald-500 text-emerald-500 live-dot"></span>
        Информация обновляется ежедневно
      </p>
    </div>

    <div class="grid gap-4 lg:grid-cols-12 lg:gap-5">
      <!-- Главная карточка: гости -->
      <article
        class="relative overflow-hidden rounded-5xl bg-ink p-7 text-white sm:p-10 lg:col-span-5"
        data-reveal
      >
        <div class="absolute -top-24 -right-24 h-72 w-72 rounded-full bg-sea/30 blur-3xl" data-parallax="60"></div>
        <div class="absolute -bottom-32 -left-20 h-80 w-80 rounded-full bg-brand/25 blur-3xl"></div>
        <div class="relative flex h-full flex-col justify-between gap-10">
          <div class="flex items-center justify-between">
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-white/10 text-brand"><Icon name="people" size={28} /></span>
            <span class="eyebrow bg-emerald-400/15 text-emerald-300">
              <span class="relative inline-block h-2 w-2 rounded-full bg-emerald-400 text-emerald-400 live-dot"></span>
              Live
            </span>
          </div>
          <div>
            <p class="num text-[clamp(2.8rem,5vw,4.5rem)] whitespace-nowrap leading-none" data-count={guests.value} data-live>{fmt(guests.value)}</p>
            <p class="mt-4 max-w-[340px] text-lg font-semibold text-white/70">{guests.label}</p>
          </div>
          <!-- Мини-график роста -->
          <svg viewBox="0 0 300 80" class="w-full" aria-hidden="true">
            <defs>
              <linearGradient id="g-area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f7941d" stop-opacity=".45"></stop>
                <stop offset="1" stop-color="#f7941d" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="M0 74 C40 72 60 66 90 60 S150 44 180 36 240 14 300 6 V80 H0Z" fill="url(#g-area)"></path>
            <path class="draw-on-view" d="M0 74 C40 72 60 66 90 60 S150 44 180 36 240 14 300 6" fill="none" stroke="#f7941d" stroke-width="3" stroke-linecap="round"></path>
            <circle cx="300" cy="6" r="5" fill="#f7941d"></circle>
          </svg>
        </div>
      </article>

      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7 lg:gap-5">
      {
        stats.map((s, i) => (
          <article class="card group relative flex flex-col justify-between overflow-hidden p-7 sm:p-8" data-reveal>
            <div class="absolute -top-10 -right-10 h-40 w-40 rounded-full bg-gradient-to-br from-brand/15 to-transparent transition-transform duration-700 group-hover:scale-150" />
            <div class="relative flex h-full flex-col-reverse justify-between gap-8">
              <div>
                <p class="num text-[clamp(2.4rem,4.4vw,3.4rem)] leading-none text-ink" data-count={s.value} data-suffix={s.suffix} data-delay={i * 120}>
                  {fmt(s.value)}
                  {s.suffix}
                </p>
                <p class="mt-3 max-w-[300px] text-[15px] font-bold tracking-wide text-muted uppercase">{s.label}</p>
              </div>
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-brand to-brand-600 text-white shadow-[0_10px_24px_-10px_rgba(247,148,29,0.8)]">
                <Icon name={s.icon} size={26} />
              </span>
            </div>
          </article>
        ))
      }
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, reduce } from '../scripts/motion';

  // График рисуется при появлении
  document.querySelectorAll<SVGPathElement>('.draw-on-view').forEach((p) => {
    if (reduce) return;
    gsap.fromTo(p, { drawSVG: '0%' }, { drawSVG: '100%', duration: 2.2, ease: 'power2.inOut', scrollTrigger: { trigger: p, start: 'top 90%', once: true } });
  });

  // «Живой» счётчик гостей: время от времени прибавляет бронирования
  const live = document.querySelector<HTMLElement>('[data-live]');
  if (live) {
    let value = Number(live.dataset.count);
    live.addEventListener('counted', () => {
      const tick = () => {
        value += 1 + Math.floor(Math.random() * 3);
        (live as any).__flow?.update(value);
        setTimeout(tick, 3500 + Math.random() * 4000);
      };
      setTimeout(tick, 4500);
    });
  }
  ScrollTrigger.refresh();
</script>
