---
import Ship from './art/Ship.astro';
import Plane from './art/Plane.astro';
import { contactLink } from '../config';

/** Бесшовная волна: path шириной 2×W (два одинаковых периода для зацикливания). */
function wave(W: number, H: number, amp: number, periods: number, phase = 0) {
  const total = W * 2;
  const step = 8;
  let d = `M0 ${H}`;
  for (let x = 0; x <= total; x += step) {
    const y = H / 2 + Math.sin((x / W) * Math.PI * 2 * periods + phase) * amp + Math.sin((x / W) * Math.PI * 2 * periods * 2.3 + phase * 2) * amp * 0.25;
    d += ` L${x} ${y.toFixed(2)}`;
  }
  return d + ` L${total} ${H} Z`;
}
const W = 1600;
const layers = [
  { cls: 'top-[calc(var(--hz)-10px)] h-[24px] opacity-50', color: '#5d93d1', amp: 3, p: 16, dur: 30, ph: 0 },
  { cls: 'top-[calc(var(--hz)+4px)] h-[36px] opacity-80', color: '#2563a8', amp: 4, p: 11, dur: 20, ph: 1, front: true },
  { cls: 'top-[calc(var(--hz)+22px)] h-[48px] opacity-90', color: '#174a88', amp: 5, p: 8, dur: 15, ph: 2, front: true },
  { cls: 'bottom-[-2px] h-[70px] sm:h-[96px]', color: '#f5f8fc', amp: 5, p: 3, dur: 24, ph: 0.5, front: true },
];
---

<section id="top" class="relative isolate h-[100svh] min-h-[720px] overflow-hidden [--hz:76%] sm:[--hz:70%] bg-ink text-white" aria-label="Главный экран">
  <!-- Небо -->
  <div class="absolute inset-x-0 top-0 h-(--hz) bg-[linear-gradient(180deg,#040e1f_0%,#0a2244_32%,#1d4f8f_62%,#5d86b8_80%,#f0a868_95%,#ffd59a_100%)]"></div>

  <!-- Звёзды -->
  <svg class="absolute inset-x-0 top-0 h-[45%] w-full opacity-70" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 100 40">
    {
      Array.from({ length: 60 }, (_, i) => {
        const x = (i * 37.7) % 100;
        const y = (i * 13.3) % 38;
        const r = 0.08 + ((i * 7) % 5) * 0.03;
        return <circle cx={x} cy={y} r={r} fill="white" opacity={0.3 + ((i * 3) % 7) / 10} />;
      })
    }
  </svg>

  <!-- Солнце и свечение -->
  <div class="pointer-events-none absolute top-(--hz) left-[72%] -translate-x-1/2 -translate-y-1/2" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 h-[70vmax] w-[70vmax] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(255,190,110,0.45)_0%,rgba(255,160,90,0.15)_30%,transparent_60%)]"></div>
    <div id="sun" class="relative h-[clamp(110px,15vw,240px)] w-[clamp(110px,15vw,240px)] rounded-full bg-[radial-gradient(circle_at_50%_40%,#fffbe8_0%,#ffe1a1_45%,#ffb15e_100%)] shadow-[0_0_80px_30px_rgba(255,180,100,0.45)]"></div>
  </div>

  <!-- Облака -->
  <div class="pointer-events-none absolute inset-x-0 top-[18%] h-[40%]" aria-hidden="true">
    <div class="absolute top-[30%] left-[8%] h-10 w-72 rounded-full bg-white/10 blur-2xl" style="animation: drift 60s linear infinite alternate; --drift: 160px"></div>
    <div class="absolute top-[55%] left-[45%] h-8 w-96 rounded-full bg-[#ffd9b0]/15 blur-2xl" style="animation: drift 80s linear infinite alternate; --drift: -200px"></div>
    <div class="absolute top-[10%] right-[6%] h-12 w-80 rounded-full bg-white/8 blur-3xl" style="animation: drift 70s linear infinite alternate; --drift: -120px"></div>
  </div>

  <!-- Самолёт с инверсионным следом -->
  <svg class="pointer-events-none absolute inset-x-0 top-0 h-(--hz) w-full" viewBox="0 0 1600 630" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="trail-grad" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="white" stop-opacity="0"></stop>
        <stop offset="1" stop-color="white" stop-opacity=".7"></stop>
      </linearGradient>
    </defs>
    <path id="plane-path" d="M-140 470 C 320 250, 880 70, 1760 130" fill="none" stroke="none"></path>
    <path id="plane-trail" d="M-140 470 C 320 250, 880 70, 1760 130" fill="none" stroke="white" stroke-opacity=".55" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="1 0"></path>
    <Plane id="plane" scale={0.55} />
    <!-- Чайки -->
    <g id="gulls" stroke="white" stroke-width="2.2" fill="none" stroke-linecap="round" opacity=".75">
      <path class="gull" d="M0 0 q7 -7 14 0 q7 -7 14 0" transform="translate(260 300)"></path>
      <path class="gull" d="M0 0 q5 -5 10 0 q5 -5 10 0" transform="translate(320 330)"></path>
      <path class="gull" d="M0 0 q4 -4 8 0 q4 -4 8 0" transform="translate(300 270)"></path>
    </g>
  </svg>

  <!-- Море -->
  <div class="absolute inset-x-0 top-(--hz) bottom-0 bg-[linear-gradient(180deg,#3b7cc4_0%,#174a88_25%,#0b2d5c_60%,#06152b_100%)]"></div>
  <!-- Дорожка солнца на воде -->
  <div class="pointer-events-none absolute top-(--hz) bottom-0 left-[72%] w-[clamp(120px,16vw,260px)] -translate-x-1/2 bg-[repeating-linear-gradient(180deg,rgba(255,214,150,0.55)_0px,rgba(255,214,150,0.55)_2px,transparent_2px,transparent_9px)] opacity-70 [mask-image:linear-gradient(180deg,black,transparent_75%)]" style="animation: bob 3s ease-in-out infinite" aria-hidden="true"></div>

  <!-- Дальняя волна (за кораблём) -->
  {
    layers.filter((l) => !l.front).map((l) => (
      <div class={`pointer-events-none absolute inset-x-0 overflow-hidden ${l.cls}`} aria-hidden="true">
        <svg class="wave-layer h-full w-[200%]" style={`--dur:${l.dur}s`} viewBox={`0 0 ${W * 2} 40`} preserveAspectRatio="none">
          <path d={wave(W, 40, l.amp, l.p, l.ph)} fill={l.color} />
        </svg>
      </div>
    ))
  }

  <!-- Корабль -->
  <div id="hero-ship-wrap" class="absolute top-(--hz) left-1/2 w-[clamp(250px,40vw,600px)] -translate-x-1/2 -translate-y-[80%] md:left-[70%] lg:w-[min(34vw,600px)] lg:left-[73%]">
    <div class="bob">
      <Ship id="hero-ship" class="w-full drop-shadow-[0_20px_30px_rgba(0,0,0,0.35)]" />
    </div>
    <!-- Кильватерная пена -->
    <div class="absolute right-[88%] bottom-[12%] h-3 w-[60%] rounded-full bg-gradient-to-l from-white/70 to-transparent blur-[3px]"></div>
  </div>

  <!-- Передние волны -->
  {
    layers.filter((l) => l.front).map((l) => (
      <div class={`pointer-events-none absolute inset-x-0 overflow-hidden ${l.cls}`} aria-hidden="true">
        <svg class="wave-layer h-full w-[200%]" style={`--dur:${l.dur}s`} viewBox={`0 0 ${W * 2} 40`} preserveAspectRatio="none">
          <path d={wave(W, 40, l.amp, l.p, l.ph)} fill={l.color} />
        </svg>
      </div>
    ))
  }

  <!-- Текст -->
  <div id="hero-copy" class="container-x relative z-10 pt-[clamp(108px,17vh,190px)]">
    <div class="max-w-[700px]">
      <p class="eyebrow mb-6 border border-white/15 bg-white/10 text-white/90 backdrop-blur-md" data-reveal>
        <span class="relative inline-block h-2 w-2 rounded-full bg-brand text-brand live-dot"></span>
        Независимый партнёр inCruises · BoardTeam
      </p>
      <h1 class="font-display text-[clamp(2rem,min(5.2vw,7.4vh),4.4rem)] leading-[1.02] font-bold tracking-[-0.03em] text-balance" data-split="now">
        Самый ценный в&nbsp;мире клуб <span class="text-gradient-brand">туристических вознаграждений</span>
      </h1>
      <p class="lead mt-6 max-w-[560px] text-white/75" data-reveal>
        Круизы, отели и&nbsp;туры по&nbsp;клубным ценам — с&nbsp;экономией до&nbsp;100% и&nbsp;возможностью зарабатывать, путешествуя.
      </p>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal>
        <a href={contactLink()} class="btn-brand">
          Стать членом клуба
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="#plans" class="btn-glass hidden sm:inline-flex">Посчитать выгоду</a>
      </div>
    </div>
  </div>

  <!-- Подсказка прокрутки -->
  <a href="#numbers" class="absolute bottom-[clamp(96px,13vh,140px)] left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-2 text-[11px] font-bold tracking-[0.2em] text-white/60 uppercase md:flex" aria-label="Листайте вниз">
    <span class="relative h-9 w-5 rounded-full border-2 border-white/40">
      <span class="absolute top-1.5 left-1/2 h-2 w-1 -translate-x-1/2 rounded-full bg-white/80" style="animation: bob 1.6s ease-in-out infinite"></span>
    </span>
  </a>
</section>

<script>
  import { gsap, reduce } from '../scripts/motion';

  if (!reduce) {
    // Самолёт летит по дуге, за ним тянется след
    const trail = document.getElementById('plane-trail')!;
    gsap.set(trail, { drawSVG: '0% 0%' });
    gsap.set('#plane', { motionPath: { path: '#plane-path', align: '#plane-path', alignOrigin: [0.5, 0.5], autoRotate: true, end: 0 } });
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 2.5, delay: 0.8 });
    const prog = { p: 0 };
    tl.to('#plane', {
      duration: 16,
      ease: 'none',
      motionPath: { path: '#plane-path', align: '#plane-path', alignOrigin: [0.5, 0.5], autoRotate: true },
    }).to(
      prog,
      {
        p: 1,
        duration: 16,
        ease: 'none',
        onUpdate: () => gsap.set(trail, { drawSVG: `${Math.max(0, prog.p - 0.28) * 100}% ${prog.p * 100}%` }),
      },
      0,
    );

    // Чайки машут крыльями и летят
    gsap.to('.gull', { scaleY: 0.4, transformOrigin: '50% 50%', duration: 0.35, repeat: -1, yoyo: true, ease: 'sine.inOut', stagger: 0.12 });
    gsap.to('#gulls', { x: 420, y: -60, duration: 40, ease: 'none', repeat: -1, yoyo: true });

    // Корабль выплывает при загрузке, при прокрутке уходит вправо
    gsap.from('#hero-ship-wrap', { xPercent: -160, duration: 3.2, ease: 'power3.out', delay: 0.2 });
    gsap.to('#hero-ship-wrap', {
      x: () => window.innerWidth * 0.45,
      ease: 'none',
      scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: 0.6 },
    });
    gsap.to('#hero-copy', {
      yPercent: -18,
      opacity: 0,
      ease: 'none',
      scrollTrigger: { trigger: '#top', start: 'top top', end: '70% top', scrub: true },
    });
    gsap.to('#sun', {
      y: 80,
      ease: 'none',
      scrollTrigger: { trigger: '#top', start: 'top top', end: 'bottom top', scrub: true },
    });
  }
</script>
